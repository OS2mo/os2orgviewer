# Example configuration. See app/docs/configuration.md for the full reference.
#
# Booleans must be the lowercase string `true` - anything else (including `True`) is false.
# Lists are comma-separated; quotes, brackets and spaces are stripped.

# Set production or development environment.
NODE_ENV=production

# Set the hostname and/or port of the OS2MO instance you want the application to pull data from
VUE_APP_API_BASEURL=http://localhost:5000

# The keycloak client ID
VUE_APP_KEYCLOAK_CLIENT_ID="orgviewer_med"

# The keycloak client secret
VUE_APP_KEYCLOAK_CLIENT_SECRET="30303030-3030-3030-3030-303030303030"

# Set a UUID representing whatever organisation unit you want as the default root org
VUE_APP_ROOT_UUID=f06ee470-9f17-566f-acbe-e938112d46d9

# Set type of relation between people and organisations [engagement|association|both]
# The UI will display people in organisations based on their engagement, their association or both.
VUE_APP_ORG_PERSON_RELATION=engagement

# Only show org_units marked with these org_unit_hierarchy classes, e.g. the line
# organisation or the MED organisation.
VUE_APP_ORG_UNIT_HIERARCHY_UUIDS=

# Set the application title. It will appear in the UI header and in the HTML document title.
VUE_APP_TITLE=Frederikshavn ADM-organisation

# Set local path to CSS file containing custom style variables and overrides.
# You can make a copy of `src/assets/default-theme.css` and edit it to create your own custom theme.
VUE_APP_THEME_CSS=frederikshavn.custom.css

# Set organization tree layout style [vertical|horizontal|hybrid]
VUE_APP_TREE_LAYOUT=horizontal

# Set local or global path to image file you want as your application's branding image
VUE_APP_LOGO_PATH=https://frederikshavn.dk/Resources/images/frk_logo_blue.svg

# Set local or global path to image file (usually `favicon.ico`) you want as your application's favicon.
VUE_APP_FAVICON_PATH=https://frederikshavn.dk/Resources/images/favicon.ico

# List of UUIDs of org_units you want to remove from the tree view
VUE_APP_HIDE_ORG_UNIT_UUIDS=

# List of strings. Org_units whose name contains one of the strings are removed from the
# tree view (used by Holstebro to hide units ending in "_leder").
VUE_APP_HIDE_ORG_UNITS_BY_NAME=

# List of org_unit_level UUIDs to hide in the tree view
VUE_APP_HIDE_ORG_UNIT_LEVELS=

# List of org_unit UUIDs that are always sorted to the bottom among their siblings
# (used by Silkeborg for "MJBR" and "Forsyningen")
VUE_APP_SORT_SPECIFIC_UNITS_TO_BOTTOM=

# Show the engagement's extension_1 instead of its job function (Silkeborg)
VUE_APP_SHOW_EXTENSION_1=true

# Show the engagement's extension_3 instead of its job function (Viborg)
VUE_APP_SHOW_EXTENSION_3_VIBORG=true

# Hide the org_unit email, i.e. the address with the user_key "EmailUnit"
VUE_APP_REMOVE_ORG_UNIT_EMAIL=true

# Comma-separated list of address_type user_keys to hide from org unit and person detail views.
# Example: EmailEmployee or ["EmailEmployee", "PhoneEmployee"]
VUE_APP_HIDDEN_ADDRESS_TYPE_USER_KEYS=

# Hide the number of employees/associated people on each org_unit
VUE_APP_REMOVE_PERSON_COUNT=true

# Hide the number of sub units on each org_unit
VUE_APP_REMOVE_CHILDREN_COUNT=true

# List of engagement_type UUIDs whose engagements are hidden from the person lists
VUE_APP_REMOVE_ENGAGEMENT_TYPE_UUID=

# Remove manager engagements from the engagement list
# (only use this with engagements, will fail with associations)
VUE_APP_REMOVE_MANAGER_ENGAGEMENT=true

# Show user's nickname if present, else show CPR-name
VUE_APP_SHOW_NICKNAME=true
